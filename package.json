{
  "name": "openclaw-syncralis",
  "version": "2.7.3",
  "description": "An industry-grade MCP gateway providing three capabilities: (1) secure workspace file sharing with HMAC-signed time-limited download links via Ngrok tunnel, (2) authenticated URL-to-workspace file downloads with MIME validation, and (3) load-balanced web search across Tavily and Brave with circuit-breaker failover. Requires outbound internet access and an optional Ngrok tunnel for public download links.",
  "type": "module",
  "main": "./server.js",
  "bin": {
    "openclaw-syncralis": "./server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "server.js",
    "config.js",
    "fileOps.js",
    "safegrd.js",
    "openclaw.plugin.json",
    ".env.example"
  ],
  "scripts": {
    "start": "node ./server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "openclaw",
    "ai",
    "tools",
    "file-server",
    "web-search",
    "tavily",
    "brave",
    "ngrok"
  ],
  "author": "PSLKK <coregravity0.0.0@protonmail.com> (https://pslkk.space)",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pslkk/openclaw-syncralis.git"
  },
  "bugs": {
    "url": "https://github.com/pslkk/openclaw-syncralis/issues"
  },
  "homepage": "https://github.com/pslkk/openclaw-syncralis#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "pdf-parse": "^1.1.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "express-rate-limit": {
        "ip-address": "^10.1.1",
        "hono": "^4.12.18"
      }
    }
  },
  "openclaw": {
    "type": "gateway",
    "extensions": [
      "./server.js"
    ],
    "runtimeExtensions": [
      "./server.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    },
    "configSchema": {
      "type": "object",
      "required": [],
      "properties": {
        "FILE_SERVER_PORT": {
          "type": "number",
          "default": 8080,
          "description": "The port on which the Syncralis gateway will listen."
        },
        "FILE_SERVER_HOST": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "The host interface to bind the gateway to."
        },
        "NODE_ENV": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ],
          "default": "production"
        },
        "TAVILY_API_KEY": {
          "type": "string",
          "description": "API key for Tavily web search integration."
        },
        "BRAVE_API_KEY": {
          "type": "string",
          "description": "API key for Brave web search integration."
        },
        "PUBLIC_TUNNEL_URL": {
          "type": "string",
          "description": "The public URL generated by the Ngrok tunnel."
        },
        "NGROK_AUTHTOKEN": {
          "type": "string",
          "description": "Authentication token for the Ngrok service."
        },
        "WORKSPACE_DIR": {
          "type": "string",
          "description": "Optional: Custom absolute path for the workspace volume. Leave blank to default to ~/.openclaw/workspace",
          "default": ""
        },
        "NGROK_API_PORT": {
          "type": "number",
          "default": 4040,
          "description": "Optional: The local port Ngrok uses for its API (used for auto-discovery). Default is 4040."
        },
        "URL_SIGNING_SECRET": {
          "type": "string",
          "description": "Optional: 32-byte string for signing URLs."
        }
      },
      "additionalProperties": true
    },
    "env": {
      "required": [],
      "optional": [
        "PUBLIC_TUNNEL_URL",
        "NGROK_AUTHTOKEN",
        "FILE_SERVER_HOST",
        "FILE_SERVER_PORT",
        "WORKSPACE_DIR",
        "NGROK_API_PORT",
        "TAVILY_API_KEY",
        "BRAVE_API_KEY",
        "URL_SIGNING_SECRET"
      ]
    }
  }
}
