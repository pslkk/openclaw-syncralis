{
  "name": "openclaw-syncralis",
  "version": "2.0.4",
  "description": "An industry-grade file sharing, secure download, and load-balanced gateway designed for high-availability OpenClaw environments.",
  "type": "module",
  "main": "./server.js",
  "bin": {
    "openclaw-syncralis": "./server.js"
  },
  "scripts": {
    "start": "node ./server.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "openclaw",
    "ai",
    "tools",
    "file-server",
    "web-search",
    "tavily",
    "brave",
    "ngrok"
  ],
  "author": "PSLKK <coregravity0.0.0@protonmail.com> (https://pslkk.space)",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "pdf-parse": "^2.4.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "express-rate-limit": {
        "ip-address": "^10.1.1"
      }
    }
  },
  "openclaw": {
    "type": "gateway",
    "extensions": [
      "./server.js"
    ],
    "runtimeExtensions": [
      "./server.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    },
    "configSchema": {
      "type": "object",
      "required": [],
      "properties": {
        "FILE_SERVER_PORT": {
          "type": "number",
          "default": 8080,
          "description": "The port on which the Syncralis gateway will listen."
        },
        "FILE_SERVER_HOST": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "The host interface to bind the gateway to."
        },
        "NODE_ENV": {
          "type": "string",
          "enum": [
            "development",
            "production"
          ],
          "default": "production"
        },
        "TAVILY_API_KEY": {
          "type": "string",
          "description": "API key for Tavily web search integration."
        },
        "BRAVE_API_KEY": {
          "type": "string",
          "description": "API key for Brave web search integration."
        },
        "PUBLIC_TUNNEL_URL": {
          "type": "string",
          "description": "The public URL generated by the Ngrok tunnel."
        },
        "NGROK_TOKEN": {
          "type": "string",
          "description": "Authentication token for the Ngrok service."
        }
      },
      "additionalProperties": true
    },
    "env": {
      "required": [],
      "optional": [
        "TAVILY_API_KEY",
        "BRAVE_API_KEY",
        "PUBLIC_TUNNEL_URL",
        "NGROK_TOKEN",
        "FILE_SERVER_HOST",
        "FILE_SERVER_PORT"
      ]
    }
  }
}
